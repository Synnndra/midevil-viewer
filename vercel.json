{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "wallets/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "forge/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "forge/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "forge/layers/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "forge/thumbs/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "forge/*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "forge/faces/*.webp",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/helius",
      "dest": "/api/helius.js"
    },
    {
      "src": "/api/collection",
      "dest": "/api/collection.js"
    },
    {
      "src": "/forge",
      "status": 308,
      "headers": {
        "Location": "/forge/"
      }
    },
    {
      "src": "/forge/",
      "dest": "/forge/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
